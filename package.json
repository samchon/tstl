{
  "name": "tstl-workspace",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --filter tstl build",
    "dev": "pnpm --filter tstl dev",
    "test": "pnpm run build && pnpm --filter @tstl/test test",
    "benchmark": "pnpm run build && pnpm --filter @tstl/test benchmark",
    "api": "pnpm --filter tstl api",
    "prettier": "prettier --write \"packages/tstl/src/**/*.ts\" \"test/src/**/*.ts\""
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "prettier": "^2.8.8"
  }
}
