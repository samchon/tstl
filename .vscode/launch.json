{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "TypeScript tests",
      "cwd": "${workspaceFolder}/test",
      "runtimeArgs": [
        "-r",
        "ts-node/register"
      ],
      "program": "${workspaceFolder}/test/src/test/index.ts"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Compiled tests",
      "cwd": "${workspaceFolder}/test",
      "program": "${workspaceFolder}/test/lib/test/index.js",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/test/lib/**/*.js"
      ]
    }
  ]
}
