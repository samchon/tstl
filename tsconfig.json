{
  "compilerOptions": {
    "target": "ES5",
    "module": "commonjs",
    "lib": [
      "DOM",
      "ES2015"
    ],
    "declaration": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "stripInternal": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": []
}
